<!DOCTYPE html>
<html lang="en">
  <!-- Head section remains the same until styles -->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Notes</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <!-- AOS Animation Library -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css"
    />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/homestyle.css" />
    <link rel="stylesheet" href="/viewstyle.css" />
  </head>
  <body>
    <!-- Navbar remains the same -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow fixed-top">
      <div class="container">
        <a class="navbar-brand" href="#">📚 My Book Library</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item">
              <a class="nav-link" href="/addbook">Add Book</a>
            </li>
            <li class="nav-item">
              <button class="btn btn-sm btn-warning" id="nightLightToggle">
                🌙 Night Light
              </button>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Header remains the same -->
    <header class="hero-section text-center text-white py-5">
      <div class="container" data-aos="fade-up">
        <h1 class="display-4" style="color: black">Notes for <%= title %></h1>
        <p class="lead" style="color: #2c2c2c">
          Here are the notes I took while reading this book. Hope you find them
          insightful!
        </p>
      </div>
    </header>

    <!-- Modified Notes List Section -->
    <main class="container py-5">
      <div class="row g-4">
        <% notes.forEach(note => { %>
        <div class="col-12" data-aos="zoom-in">
          <div class="card shadow-lg h-100">
            <div class="card-body">
              <h5 class="card-title text-primary"><%= note.number %></h5>
              <p class="card-text" id="text-<%= note.id %>"><%= note.text %></p>
              <div class="card-actions">
                <a
                  href="/edit/<%= note.id %>/<%= bookid %>"
                  class="btn btn-outline-primary btn-edit"
                >
                  <i class="fas fa-edit"></i> edit
                </a>
                <a
                  href="/delete/<%= note.id %>/<%= bookid %>"
                  class="btn btn-outline-danger btn-delete"
                >
                  <i class="fas fa-trash-alt"></i> Delete
                </a>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </main>

    <div class="card mt-4 chat-card">
      <div class="card-header bg-info text-white">
        <h5 class="mb-0">
          <i class="fas fa-robot me-2"></i>
          AI Chat About "<%= title %>"
        </h5>
      </div>

      <div class="card-body chat-body">
        <!-- Chat messages container -->
        <div id="chatMessages" class="chat-messages">
          <!-- Messages will be dynamically inserted here -->
        </div>

        <!-- Typing indicator -->
        <div id="chatTyping" class="chat-typing" style="display: none">
          <div class="chat-message ai">
            <div class="chat-bubble ai-bubble">
              <i class="fas fa-robot me-2"></i>
              <span class="typing-dots">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
              </span>
            </div>
          </div>
        </div>

        <!-- Chat input -->
        <div class="chat-input-area">
          <form id="chatForm" class="chat-form">
            <input
              type="text"
              class="form-control chat-input"
              id="chatInput"
              placeholder="Ask anything about this book or your notes..."
              autocomplete="off"
              required
            />
            <button type="submit" class="btn btn-info chat-send-btn">
              <i class="fas fa-paper-plane"></i>
            </button>
          </form>
        </div>
      </div>
    </div>

    <script>
      const bookId = "<%= bookid %>";
      const bookTitle = "<%= title %>";
      let isLoading = false;

      // ---- Chat UI Logic ----

      function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
      }

      function formatMessage(text) {
        return escapeHtml(text).replace(/\n/g, "<br>");
      }

      function appendMessage(role, message) {
        const chatMessages = document.getElementById("chatMessages");
        const wrapper = document.createElement("div");
        wrapper.className = "chat-message " + (role === "user" ? "user" : "ai");

        const bubble = document.createElement("div");
        bubble.className = "chat-bubble " + (role === "user" ? "user-bubble" : "ai-bubble");

        if (role === "ai") {
          const icon = document.createElement("i");
          icon.className = "fas fa-robot me-2";
          bubble.appendChild(icon);
        }

        const span = document.createElement("span");
        span.innerHTML = formatMessage(message);
        bubble.appendChild(span);

        wrapper.appendChild(bubble);
        chatMessages.appendChild(wrapper);
        scrollToBottom();
      }

      function scrollToBottom() {
        const chatMessages = document.getElementById("chatMessages");
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      // Load previous chat history on page load
      async function loadChatHistory() {
        try {
          const response = await fetch(`/qa/history/${bookId}`);
          const data = await response.json();

          if (data.success && data.history && data.history.length > 0) {
            data.history.forEach((msg) => {
              appendMessage(msg.role, msg.message);
            });
          } else {
            // Show welcome message if no history
            appendMessage("ai", `Hi! I'm your AI reading assistant. Ask me anything about "${bookTitle}" — its themes, characters, author, or your personal notes.`);
          }
        } catch (error) {
          console.error("Error loading chat history:", error);
          appendMessage("ai", `Hi! I'm your AI reading assistant. Ask me anything about "${bookTitle}".`);
        }
      }

      // Handle chat form submission
      document.getElementById("chatForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        if (isLoading) return;

        const input = document.getElementById("chatInput");
        const question = input.value.trim();

        if (!question) return;

        // Show user message
        appendMessage("user", question);

        // Clear input
        input.value = "";

        // Show typing indicator
        isLoading = true;
        document.getElementById("chatTyping").style.display = "block";
        scrollToBottom();

        try {
          const response = await fetch(`/qa/book/${bookId}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ question }),
          });

          const data = await response.json();

          // Hide typing indicator
          document.getElementById("chatTyping").style.display = "none";
          isLoading = false;

          if (data.success) {
            appendMessage("ai", data.answer);
          } else {
            appendMessage("ai", data.error || "Sorry, I could not answer that question.");
          }
        } catch (error) {
          document.getElementById("chatTyping").style.display = "none";
          isLoading = false;
          appendMessage("ai", "Error: Could not connect to AI service.");
        }
      });

      // Load history when page loads
      loadChatHistory();
    </script>

    <!-- Footer remains the same -->
    <footer class="bg-dark text-center text-white py-3">
      <p>
        &copy; <%= new Date().getFullYear() %> My Book Library | Created with ❤️
      </p>
    </footer>

    <!-- Scripts -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <!-- Custom JS -->
    <script>
      // Initialize AOS
      AOS.init();

      // Night Light Toggle
      const nightLightToggle = document.getElementById("nightLightToggle");
      const body = document.body;

      // Check localStorage for night light preference
      if (localStorage.getItem("night-light") === "enabled") {
        enableNightLight();
      }

      nightLightToggle.addEventListener("click", () => {
        if (localStorage.getItem("night-light") === "enabled") {
          disableNightLight();
        } else {
          enableNightLight();
        }
      });

      function enableNightLight() {
        body.classList.add("night-light");
        nightLightToggle.innerText = "☀️ Day Mode";
        localStorage.setItem("night-light", "enabled");
      }

      function disableNightLight() {
        body.classList.remove("night-light");
        nightLightToggle.innerText = "🌙 Night Light";
        localStorage.setItem("night-light", "disabled");
      }
    </script>
  </body>
</html>
